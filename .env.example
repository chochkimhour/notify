# Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs that receive reminders (users, groups or channels)
TELEGRAM_CHAT_IDS=
# Random string Telegram sends with each webhook request
TELEGRAM_WEBHOOK_SECRET=
# Random string GitHub Actions sends to /api/send-alert
ALERT_SECRET=
# Optional: debug, info (default), warn, error or silent
LOG_LEVEL=info
